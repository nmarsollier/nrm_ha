diff --git a/main/geometry/geometry_common.c b/main/geometry/geometry_common.c
new file mode 100644
index 0000000..182e906
--- /dev/null
+++ b/main/geometry/geometry_common.c
@@ -0,0 +1,28 @@
+/* Geometry — geometry_common.c — shared time helpers.
+ *
+ * The Julian Date / GMST / LST math is shared by every geometry implementation
+ * (German and fork).  Pure functions of the fractional unix instant and the
+ * site longitude.  The slew-ramp math lives in main/motion/slew_ramp.c.
+ */
+#include "mount_geometry.h"
+
+#include <math.h>
+
+double geometry_gmst_hours(double unix_seconds) {
+    double jd = unix_seconds / 86400.0 + 2440587.5;
+    double T = (jd - 2451545.0) / 36525.0;
+    double gmst_deg = 280.46061837 + 360.98564736629 * (jd - 2451545.0)
+                      + 0.000387933 * T * T - (T * T * T) / 38710000.0;
+    gmst_deg = fmod(gmst_deg, 360.0);
+    if (gmst_deg < 0.0) gmst_deg += 360.0;
+    return gmst_deg / 15.0;
+}
+
+float geometry_lst(float lon_deg, double unix_seconds) {
+    /* Normalise to [0, 24).  fmod keeps this O(1) and cannot spin forever on a
+     * non-finite longitude read from a corrupted settings store. */
+    double lst_h = geometry_gmst_hours(unix_seconds) + (lon_deg / 15.0);
+    lst_h = fmod(lst_h, 24.0);
+    if (lst_h < 0.0) lst_h += 24.0;
+    return (float) lst_h;
+}
diff --git a/main/geometry/geometry_fork.c b/main/geometry/geometry_fork.c
new file mode 100644
index 0000000..f5fccb3
--- /dev/null
+++ b/main/geometry/geometry_fork.c
@@ -0,0 +1,288 @@
+/* Geometry — geometry_fork.c — fork equatorial mount geometry.
+ *
+ * Purpose: convert between physical axis coordinates and equatorial
+ * coordinates for a polar-aligned equatorial mount in either hemisphere.
+ * Pure — the site (latitude/longitude), the fractional instant and the
+ * mechanical limits arrive in the GeometryContext; no global state or wall
+ * clock is read.
+ *
+ * Mechanical conventions:
+ *   R = ra_axis_deg, D = dec_axis_deg (absolute final-axis angles, D linear).
+ *   Home (R=0, D=0) points at the reference pole:
+ *       southern hemisphere (lat < 0): South Celestial Pole, dec = -90.
+ *       northern hemisphere (lat > 0): North Celestial Pole, dec = +90.
+ *   R positive moves the pointing west and increases the hour angle (H = R).
+ *
+ * The reference pole is selected by the latitude sign:
+ *   p = +1 north (lat > 0), -1 south (lat <= 0). lat == 0 uses the southern
+ *   convention (documented and covered by a test).
+ *
+ * Forward (axis -> equatorial), with Z toward the north celestial pole, X
+ * toward H=0/dec=0, Y toward H=+90/dec=0:
+ *   x = sin(D) cos(R);  y = sin(D) sin(R);  z = p cos(D)
+ *   dec = atan2(z, hypot(x,y));  H = atan2(y,x);  ra = LST - H/15
+ *
+ * Reverse (equatorial -> axis) enumerates the equivalent representations
+ * generated by the flip symmetry and the 360° periodicity:
+ *   R = H + 180*f + 360k,  D = (1 - 2f)*c + 360m,  with c = 90 - p*dec, f in {0,1}
+ * and picks the minimum |dR| + |dD| from the current position. At a celestial
+ * pole (dec = ±90) the RA is indeterminate: the current R is kept and the
+ * representation of the REQUESTED pole with the least DEC travel is chosen.
+ *
+ * When a slew speed is supplied, each candidate is advanced by the sidereal
+ * rate over its own travel time before being validated and compared, so a
+ * target whose nearest solution would drift past a limit during the move is
+ * still reached through the other solution.
+ */
+#include "mount_geometry.h"
+
+#include <math.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "mount_profile.h"
+
+#include "motion/axis_units.h"
+#include "motion/slew_ramp.h"
+
+#define MOUNT_PI             3.14159265358979323846
+#define MOUNT_POLE_SIN_EPS   1e-6    /* |sin D| < this => pole (≈0.51 microstep) */
+#define MOUNT_POLE_COS_EPS   1e-6    /* |cos dec| < this => celestial-pole target */
+
+static double deg_to_rad(double d) { return d * MOUNT_PI / 180.0; }
+static double rad_to_deg(double r) { return r * 180.0 / MOUNT_PI; }
+
+/* Normalise RA hours to [0, 24). */
+static float normalize_hours(double h) {
+    h = fmod(h, 24.0);
+    if (h < 0.0) h += 24.0;
+    return (float) h;
+}
+
+/* Hemisphere pole sign: +1 north (lat > 0), -1 south (lat <= 0). */
+static double pole_sign(float lat) {
+    return (lat > 0.0f) ? 1.0 : -1.0;
+}
+
+/* Quantize a destination angle with the shared axis-unit conversion, clamp it
+ * to the nearest step whose DEGREE value stays inside [limit_min, limit_max]
+ * (the limits are never rounded outward).  Returns false when the interval
+ * contains no representable step (lo > hi) or the float round-trip lands
+ * outside the limits. */
+static bool quantize_within(AxisId axis, double degrees, float limit_min,
+                            float limit_max, float *out) {
+    double step = axis_deg_per_step(axis);
+    int64_t lo = (int64_t) ceil(limit_min / step);
+    int64_t hi = (int64_t) floor(limit_max / step);
+    if (lo > hi) {
+        return false;   /* interval narrower than one step: no valid step */
+    }
+
+    int64_t steps = axis_deg_to_steps(axis, degrees);
+    if (steps < lo) steps = lo;
+    if (steps > hi) steps = hi;
+
+    double deg = axis_steps_to_deg(axis, steps);
+    if (deg < limit_min || deg > limit_max) {
+        return false;   /* float round-trip landed outside the limits */
+    }
+
+    *out = (float) deg;
+    return true;
+}
+
+/* --------------------------------------------------------------------------
+ * Axis -> Equatorial  (pure forward conversion)
+ * -------------------------------------------------------------------------- */
+EquatorialCoordinates geometry_axis_to_equatorial(const GeometryContext *ctx,
+                                                  AxisCoordinates axis) {
+    EquatorialCoordinates out;
+    double p = pole_sign(ctx->lat_deg);
+
+    double R = deg_to_rad(axis.ra_axis_deg);
+    double D = deg_to_rad(axis.dec_axis_deg);
+    double sD = sin(D);
+    double x = sD * cos(R);
+    double y = sD * sin(R);
+    double z = p * cos(D);
+
+    double dec_deg = rad_to_deg(atan2(z, hypot(x, y)));
+    double lst = geometry_lst(ctx->lon_deg, ctx->unix_seconds);
+
+    double ra_hours;
+    if (fabs(sD) < MOUNT_POLE_SIN_EPS) {
+        /* Celestial pole: RA is indeterminate. Finite, deterministic convention
+         * derived from the current position: ra = LST - R/15. */
+        ra_hours = lst - axis.ra_axis_deg / 15.0;
+    } else {
+        double H = rad_to_deg(atan2(y, x));
+        ra_hours = lst - H / 15.0;
+    }
+
+    out.ra_hours = normalize_hours(ra_hours);
+    out.dec_deg = (float) dec_deg;
+    return out;
+}
+
+/* --------------------------------------------------------------------------
+ * Equatorial -> Axis (reverse, minimum-travel selection with arrival
+ * compensation per candidate)
+ * -------------------------------------------------------------------------- */
+bool geometry_equatorial_to_axis(const GeometryContext *ctx,
+                                 EquatorialCoordinates eq,
+                                 AxisCoordinates current,
+                                 PierSideRequirement required,
+                                 float speed_dps,
+                                 AxisCoordinates *out) {
+    /* The fork has no pier-side selection: an explicit EAST/WEST request is not
+     * applicable and is rejected. */
+    if (required != PIER_SIDE_AUTO) {
+        return false;
+    }
+
+    if (!out || !isfinite(eq.ra_hours) || !isfinite(eq.dec_deg) ||
+        !isfinite(current.ra_axis_deg) || !isfinite(current.dec_axis_deg) ||
+        eq.dec_deg < -90.0f || eq.dec_deg > 90.0f) {
+        return false;
+    }
+
+    double p = pole_sign(ctx->lat_deg);
+    double dec = eq.dec_deg;
+    double step = axis_steps_to_deg(AXIS_RA, 1);   /* one microstep: tie tolerance + quantization */
+    const GeometryLimits *limits = &ctx->limits;
+
+    /* Celestial-pole target: RA is arbitrary. Keep the current R (if valid) and
+     * pick the representation of the REQUESTED pole with the least DEC travel.
+     * A request for the north pole must not fall back to D=0 (the south pole)
+     * just because it is closer. */
+    if (fabs(cos(deg_to_rad(dec))) < MOUNT_POLE_COS_EPS) {
+        double c = 90.0 - p * dec;               /* ~0 (reference) or ~180 (opposite) */
+        double d_base = (c < 90.0) ? 0.0 : 180.0;
+        int m_min = (int) ceil((limits->dec_min - d_base) / 360.0);
+        int m_max = (int) floor((limits->dec_max - d_base) / 360.0);
+
+        double best_d = NAN, best_cost = INFINITY;
+        for (int m = m_min; m <= m_max; m++) {
+            double D = d_base + 360.0 * m;
+            double cost = fabs(D - current.dec_axis_deg);
+            if (cost < best_cost) { best_cost = cost; best_d = D; }
+        }
+        if (!isfinite(best_d)) return false;
+        if (current.ra_axis_deg < limits->ra_min || current.ra_axis_deg > limits->ra_max) {
+            return false;
+        }
+        float d_q;
+        if (!quantize_within(AXIS_DEC, best_d, limits->dec_min, limits->dec_max, &d_q)) {
+            return false;
+        }
+        out->ra_axis_deg = current.ra_axis_deg;
+        out->dec_axis_deg = d_q;
+        out->pier_side = -1;   /* fork: no pier side */
+        return true;
+    }
+
+    double c = 90.0 - p * dec;
+    double alpha = fmod(eq.ra_hours, 24.0);
+    if (alpha < 0.0) alpha += 24.0;
+    double lst = geometry_lst(ctx->lon_deg, ctx->unix_seconds);
+    double H = 15.0 * (lst - alpha);   /* degrees */
+
+    bool found = false;
+    double best_cost = INFINITY, best_dr = INFINITY, best_dd = INFINITY;
+    double best_ra = NAN, best_dec = NAN;
+
+    for (int b = 0; b <= 1; b++) {
+        double r0 = H + 180.0 * b;
+        double d0 = (b == 0) ? c : -c;
+        /* The lower k bound is widened by one so a candidate whose request-time
+         * RA is just below ra_min (but whose arrival-compensated RA lands inside
+         * the limits) is still considered and filtered below. */
+        int k_min = (int) ceil((limits->ra_min - r0) / 360.0) - 1;
+        int k_max = (int) floor((limits->ra_max - r0) / 360.0);
+        int m_min = (int) ceil((limits->dec_min - d0) / 360.0);
+        int m_max = (int) floor((limits->dec_max - d0) / 360.0);
+
+        for (int k = k_min; k <= k_max; k++) {
+            double R = r0 + 360.0 * k;   /* RA axis at the request time */
+            for (int m = m_min; m <= m_max; m++) {
+                double D = d0 + 360.0 * m;
+
+                /* The sky advances during the slew: each candidate is advanced
+                 * by the sidereal rate over ITS OWN travel time, then validated
+                 * against the limits before the minimum-travel choice. */
+                double dr = fabs(R - current.ra_axis_deg);
+                double dd = fabs(D - current.dec_axis_deg);
+                /* Ramp-aware travel time: the slower axis bounds the duration,
+                 * and the real accel/decel ramp makes it slower than constant
+                 * velocity.  The duration is taken per axis because the maximum
+                 * duration does not always match the maximum distance (regime
+                 * changes at the 2° and 8° thresholds). */
+                double ra_dur = slew_ramp_duration(&mount_profile.slew, (float) dr, speed_dps);
+                double dec_dur = slew_ramp_duration(&mount_profile.slew, (float) dd, speed_dps);
+                double duration = fmax(ra_dur, dec_dur);
+                double R_arr = R + GEOMETRY_SIDEREAL_DPS * duration;
+
+                if (R_arr < limits->ra_min || R_arr > limits->ra_max) continue;
+
+                /* Quantize with the mount's own degrees->steps conversion and
+                 * clamp to the nearest interior step; discard the candidate if
+                 * the interval holds no representable step. The cost is compared
+                 * on the float values, not the quantized ones. */
+                float R_q, D_q;
+                if (!quantize_within(AXIS_RA, R_arr, limits->ra_min, limits->ra_max, &R_q) ||
+                    !quantize_within(AXIS_DEC, D, limits->dec_min, limits->dec_max, &D_q)) {
+                    continue;
+                }
+
+                double dr_arr = fabs(R_arr - current.ra_axis_deg);
+                double cost = dr_arr + dd;
+
+                bool better;
+                if (fabs(cost - best_cost) > step) {
+                    better = cost < best_cost;
+                } else if (fabs(dr_arr - best_dr) > step) {
+                    better = dr_arr < best_dr;
+                } else if (fabs(dd - best_dd) > step) {
+                    better = dd < best_dd;
+                } else {
+                    /* Fully tied: fixed order wins (A before B, k asc, m asc). */
+                    better = false;
+                }
+
+                if (better) {
+                    best_cost = cost; best_dr = dr_arr; best_dd = dd;
+                    best_ra = R_q; best_dec = D_q;
+                    found = true;
+                }
+            }
+        }
+    }
+
+    if (!found) return false;
+    out->ra_axis_deg = (float) best_ra;
+    out->dec_axis_deg = (float) best_dec;
+    out->pier_side = -1;   /* fork: no pier side */
+    return true;
+}
+
+/* --------------------------------------------------------------------------
+ * Plan a goto: minimum-travel selection with per-candidate arrival
+ * compensation, from a single context.
+ * -------------------------------------------------------------------------- */
+bool geometry_plan_goto(const GeometryContext *ctx, EquatorialCoordinates eq,
+                        AxisCoordinates current, PierSideRequirement required,
+                        float speed_dps, GotoPlan *plan) {
+    if (!plan) {
+        return false;
+    }
+    if (!geometry_equatorial_to_axis(ctx, eq, current, required, speed_dps,
+                                     &plan->target)) {
+        return false;
+    }
+    plan->pier_side = -1;   /* fork: no pier side */
+    float dr = fabsf(plan->target.ra_axis_deg - current.ra_axis_deg);
+    float dd = fabsf(plan->target.dec_axis_deg - current.dec_axis_deg);
+    plan->duration_s = fmaxf(slew_ramp_duration(&mount_profile.slew, dr, speed_dps),
+                             slew_ramp_duration(&mount_profile.slew, dd, speed_dps));
+    return true;
+}
diff --git a/main/geometry/geometry_fork_horizon.c b/main/geometry/geometry_fork_horizon.c
new file mode 100644
index 0000000..b395d1b
--- /dev/null
+++ b/main/geometry/geometry_fork_horizon.c
@@ -0,0 +1,127 @@
+/* Geometry — geometry_fork_horizon.c — geometric-horizon validation.
+ *
+ * The fork mount must never point below the geometric horizon.  A slew moves
+ * each axis monotonically, so the whole trajectory is contained in the
+ * axis-aligned rectangle bounded by the start and destination mechanical
+ * coordinates.  Validating the minimum altitude over that rectangle is the
+ * conservative check required: it rejects some physically valid detours but
+ * never admits a path that dips below the horizon.
+ *
+ * The functions are pure in (mechanical angles, latitude) so both the mount
+ * layer (validation at request time) and, later, the motion task (re-validation
+ * at execution) use the same math.
+ */
+#include "mount_geometry.h"
+
+#include <math.h>
+#include <stdbool.h>
+
+#define GEOMETRY_PI 3.14159265358979323846
+
+static double deg_to_rad(double d) { return d * GEOMETRY_PI / 180.0; }
+static double rad_to_deg(double r) { return r * 180.0 / GEOMETRY_PI; }
+
+/*
+ * sin(geometric altitude) for a mechanical position at a site latitude.
+ *
+ * With φ = |latitude| and the telescope's unit pointing derived from the
+ * polar-aligned geometry, the horizon test is:
+ *
+ *     sin(altitude) = cos(φ)·sin(D)·cos(R) + sin(φ)·cos(D)
+ */
+double geometry_altitude_sin(float ra_axis_deg, float dec_axis_deg, float lat) {
+    double phi = fabs(deg_to_rad((double) lat));
+    double R = deg_to_rad((double) ra_axis_deg);
+    double D = deg_to_rad((double) dec_axis_deg);
+    return cos(phi) * sin(D) * cos(R) + sin(phi) * cos(D);
+}
+
+/*
+ * Evaluate a candidate (R, D), plus its ±360° periodic shifts in each axis,
+ * and fold any instance inside the rectangle into *best.
+ */
+static void consider(double R, double D,
+                     double R_lo, double R_hi, double D_lo, double D_hi,
+                     double c, double s, double *best) {
+    for (int kr = -1; kr <= 1; kr++) {
+        for (int kd = -1; kd <= 1; kd++) {
+            double rr = R + 360.0 * kr;
+            double dd = D + 360.0 * kd;
+            if (rr >= R_lo && rr <= R_hi && dd >= D_lo && dd <= D_hi) {
+                double v = c * sin(deg_to_rad(dd)) * cos(deg_to_rad(rr))
+                         + s * cos(deg_to_rad(dd));
+                if (v < *best) *best = v;
+            }
+        }
+    }
+}
+
+/*
+ * True when every mechanical position in the axis-aligned rectangle from
+ * (ra_from, dec_from) to (ra_to, dec_to) is at or above the geometric horizon.
+ *
+ * The minimum of a smooth function on a compact rectangle is attained at a
+ * corner, on an edge, or at an interior critical point, so all three families
+ * are enumerated exactly.
+ */
+bool geometry_path_above_horizon(float ra_from, float dec_from,
+                                 float ra_to, float dec_to, float lat) {
+    /* Reject non-finite or out-of-range inputs: a NaN would leave `best` at
+     * INFINITY and could authorise an invalid trajectory. */
+    if (!isfinite(ra_from) || !isfinite(dec_from) ||
+        !isfinite(ra_to) || !isfinite(dec_to) ||
+        !isfinite(lat) || fabsf(lat) > 90.0f) {
+        return false;
+    }
+
+    double R_lo = fmin((double) ra_from, (double) ra_to);
+    double R_hi = fmax((double) ra_from, (double) ra_to);
+    double D_lo = fmin((double) dec_from, (double) dec_to);
+    double D_hi = fmax((double) dec_from, (double) dec_to);
+
+    double phi = fabs(deg_to_rad((double) lat));
+    double c = cos(phi), s = sin(phi);
+    double best = INFINITY;
+
+    /* Corners. */
+    consider(R_lo, D_lo, R_lo, R_hi, D_lo, D_hi, c, s, &best);
+    consider(R_lo, D_hi, R_lo, R_hi, D_lo, D_hi, c, s, &best);
+    consider(R_hi, D_lo, R_lo, R_hi, D_lo, D_hi, c, s, &best);
+    consider(R_hi, D_hi, R_lo, R_hi, D_lo, D_hi, c, s, &best);
+
+    /* Edge critical points — R pinned at a boundary: extrema of
+     * f(D) = c·cos(R)·sin(D) + s·cos(D) = A·sin(D) + s·cos(D). */
+    for (int i = 0; i < 2; i++) {
+        double Rf = (i == 0) ? R_lo : R_hi;
+        double A = c * cos(deg_to_rad(Rf));
+        double Dc = rad_to_deg(atan2(A, s));
+        consider(Rf, Dc, R_lo, R_hi, D_lo, D_hi, c, s, &best);
+        consider(Rf, Dc + 180.0, R_lo, R_hi, D_lo, D_hi, c, s, &best);
+    }
+
+    /* Edge critical points — D pinned at a boundary: f(R) is linear in cos(R),
+     * so its derivative vanishes at sin(R) = 0 (R a multiple of 180°). */
+    for (int i = 0; i < 2; i++) {
+        double Df = (i == 0) ? D_lo : D_hi;
+        consider(0.0, Df, R_lo, R_hi, D_lo, D_hi, c, s, &best);
+        consider(180.0, Df, R_lo, R_hi, D_lo, D_hi, c, s, &best);
+    }
+
+    /* Interior critical points — both partial derivatives vanish.
+     * sin(R) = 0 with c·cos(D)·cos(R) − s·sin(D) = 0. */
+    for (int i = 0; i < 2; i++) {
+        double R0 = (i == 0) ? 0.0 : 180.0;
+        double A = c * cos(deg_to_rad(R0));
+        double Dc = rad_to_deg(atan2(A, s));
+        consider(R0, Dc, R_lo, R_hi, D_lo, D_hi, c, s, &best);
+        consider(R0, Dc + 180.0, R_lo, R_hi, D_lo, D_hi, c, s, &best);
+    }
+    /* sin(D) = 0 with c·cos(D)·cos(R) = 0, i.e. cos(R) = 0. */
+    for (int i = 0; i < 2; i++) {
+        double D0 = (i == 0) ? 0.0 : 180.0;
+        consider(90.0, D0, R_lo, R_hi, D_lo, D_hi, c, s, &best);
+        consider(270.0, D0, R_lo, R_hi, D_lo, D_hi, c, s, &best);
+    }
+
+    return isfinite(best) && best >= 0.0;
+}
diff --git a/main/geometry/geometry_german.c b/main/geometry/geometry_german.c
new file mode 100644
index 0000000..c8f6f3b
--- /dev/null
+++ b/main/geometry/geometry_german.c
@@ -0,0 +1,274 @@
+/* Geometry — geometry_german.c — German equatorial mount geometry.
+ *
+ * Purpose: convert between physical axis coordinates and equatorial
+ * coordinates for a German equatorial mount in the southern hemisphere.
+ * Pure — the site longitude, the fractional instant and the mechanical limits
+ * arrive in the GeometryContext; no global state or wall clock is read.
+ *
+ * =========================================================================
+ * MECHANICAL MODEL
+ * =========================================================================
+ *
+ * Home position (mechanical zero):
+ *   - Counterweight down, scope parallel to RA axis.
+ *   - Scope points at the South Celestial Pole (SCP).
+ *   - ra_axis = 0, dec_axis = 0.
+ *   - Reported celestial coordinates: RA = LST, DEC = -90.
+ *
+ * At mechanical home the DEC movement plane is NOT aligned with the
+ * meridian — it is rotated ~90 from it.  If you move only DEC from
+ * home, the scope sweeps laterally, not toward the zenith.  To make
+ * DEC open toward the zenith, the RA axis must first rotate to
+ * roughly +/-90 from home.
+ *
+ * The angle at which the DEC plane aligns with the meridian is a fixed
+ * mechanical constant: HOME_RA_OFFSET_DEG = 90.
+ *
+ * =========================================================================
+ * TWO MECHANICAL SOLUTIONS
+ * =========================================================================
+ *
+ * A German equatorial can point at the same sky position from two
+ * mechanically-distinct configurations (one on each side of the pier).
+ * Both are computed, and the side is selected by a destination-side policy:
+ *
+ *   pierEast (0):  ra = HA - HOME_RA_OFFSET,   dec =  DEC + 90
+ *   pierWest (1):  ra = HA + HOME_RA_OFFSET,   dec = -(DEC + 90)
+ *
+ *   target west of the meridian (HA >= 0)  ->  pierEast
+ *   target east of the meridian (HA <  0)  ->  pierWest
+ *
+ * AUTO applies an asymmetric policy keyed on the current side (the sign of the
+ * linear DEC axis):
+ *
+ *   From WEST -> flip to EAST as soon as the target crosses the meridian
+ *                (HA >= 0); if EAST is unreachable, reject — never silently
+ *                stay WEST.
+ *   From EAST -> keep EAST while it is mechanically reachable, regardless of
+ *                hour angle; return to WEST only when EAST is out of limits
+ *                and WEST is reachable.  This keeps post-flip Slew-and-Center
+ *                gotos from snapping back across the meridian.
+ *
+ * An explicit EAST/WEST request forces that side and rejects the goto when it
+ * is unreachable — so a client can demand a meridian flip and tell it apart
+ * from an ordinary goto.
+ *
+ * The mechanical jump at HA = 0 is the flip itself — inherent to a German
+ * equatorial, not a discontinuity to be avoided.
+ *
+ * DEC axis is a linear coordinate (NOT circular).  It is NOT
+ * normalised with normalize_degf() — that would incorrectly wrap
+ * +180 to -180, inverting the pier side sign.
+ */
+#include "mount_geometry.h"
+
+#include <math.h>
+#include <stdbool.h>
+
+#include "mount_profile.h"
+
+#include "motion/slew_ramp.h"
+
+/* Normalise a circular angle to [-180, +180).  +180 -> -180. */
+static float normalize_degf(float d) {
+    d = fmodf(d, 360.0f);
+    if (d >= 180.0f)  d -= 360.0f;
+    if (d < -180.0f)  d += 360.0f;
+    return d;
+}
+
+/* Normalise hours to [0, 24).  fmodf keeps this O(1) and, unlike a `while`
+ * loop, cannot spin forever on a non-finite input. */
+static float normalize_hoursf(float h) {
+    h = fmodf(h, 24.0f);
+    if (h < 0.0f) h += 24.0f;
+    return h;
+}
+
+/* Validate against the mechanical limits snapshot in the context. */
+static bool axis_within_limits(const GeometryContext *ctx, float ra, float dec) {
+    return (ra >= ctx->limits.ra_min && ra <= ctx->limits.ra_max)
+        && (dec >= ctx->limits.dec_min && dec <= ctx->limits.dec_max);
+}
+
+/* --------------------------------------------------------------------------
+ * Equatorial -> Axis  (forward conversion)
+ *
+ * Two mechanically-distinct candidates.  `required` selects the pier side:
+ * AUTO applies the asymmetric meridian policy (see the module header);
+ * EAST/WEST force that side and reject when it is unreachable.
+ * -------------------------------------------------------------------------- */
+bool geometry_equatorial_to_axis(const GeometryContext *ctx,
+                                 EquatorialCoordinates eq,
+                                 AxisCoordinates current,
+                                 PierSideRequirement required,
+                                 float speed_dps,
+                                 AxisCoordinates *out) {
+    /* The German geometry does not compensate for arrival here: the mount layer
+     * re-solves at the arrival instant (with the side locked).  `speed_dps` is
+     * therefore unused. */
+    (void) speed_dps;
+
+    if (!isfinite(eq.ra_hours) || !isfinite(eq.dec_deg)) {
+        return false;
+    }
+
+    if (eq.dec_deg < -90.0f || eq.dec_deg > 90.0f) {
+        return false;
+    }
+
+    /* `required` is an internal, reusable function's parameter: a caller that
+     * passes anything outside the AUTO/EAST/WEST range would index c[] out of
+     * bounds below. */
+    if (required < PIER_SIDE_AUTO || required > PIER_SIDE_WEST) {
+        return false;
+    }
+
+    eq.ra_hours = normalize_hoursf(eq.ra_hours);
+
+    double lst = geometry_gmst_hours(ctx->unix_seconds) + (ctx->lon_deg / 15.0);
+
+    float ha_h = fmodf((float)(lst - eq.ra_hours), 24.0f);
+    if (ha_h > 12.0f)  ha_h -= 24.0f;
+    if (ha_h < -12.0f) ha_h += 24.0f;
+
+    float ha_deg = ha_h * 15.0f;
+    float dec_base = eq.dec_deg + 90.0f;
+
+    typedef struct { float ra; float dec; int pier; } Candidate;
+    Candidate c[2];
+
+    /* pierEast: scope on east side of pier, pointing west.
+     *   ra = -(offset - HA) = HA - offset   (negated for physical motor direction) */
+    c[0].ra   = normalize_degf(ha_deg - mount_profile.ra_reference_offset_deg);
+    c[0].dec  = dec_base;
+    c[0].pier = 0;
+
+    /* pierWest: scope on west side of pier, pointing east.
+     *   ra = -(-offset - HA) = HA + offset   (negated for physical motor direction) */
+    c[1].ra   = normalize_degf(ha_deg + mount_profile.ra_reference_offset_deg);
+    c[1].dec  = -dec_base;
+    c[1].pier = 1;
+
+    /* Asymmetric AUTO policy, keyed on the current side (sign of the linear DEC
+     * axis — the same convention as axis_to_equatorial() and STATE's pier_side):
+     *   WEST -> flip EAST as soon as HA >= 0, no fallback (a flip must reject
+     *           rather than silently stay WEST).
+     *   EAST -> keep EAST while reachable; fall back to WEST only when EAST is
+     *           out of limits and WEST is reachable. */
+    int current_side = (current.dec_axis_deg >= 0.0f) ? PIER_SIDE_EAST
+                                                      : PIER_SIDE_WEST;
+
+    int desired;
+    bool allow_fallback;
+    if (required == PIER_SIDE_AUTO) {
+        if (current_side == PIER_SIDE_EAST) {
+            desired = PIER_SIDE_EAST;    /* stick to EAST */
+            allow_fallback = true;       /* -> WEST only when EAST is out of limits */
+        } else if (ha_deg >= 0.0f) {
+            desired = PIER_SIDE_EAST;    /* the flip: must not degrade to staying WEST */
+            allow_fallback = false;
+        } else {
+            desired = PIER_SIDE_WEST;    /* stay WEST; EAST allowed if WEST unreachable */
+            allow_fallback = true;
+        }
+    } else {
+        desired = required;              /* PIER_SIDE_EAST or PIER_SIDE_WEST */
+        allow_fallback = false;
+    }
+
+    int best = -1;
+    if (axis_within_limits(ctx, c[desired].ra, c[desired].dec)) {
+        best = desired;
+    } else if (allow_fallback
+               && axis_within_limits(ctx, c[1 - desired].ra, c[1 - desired].dec)) {
+        best = 1 - desired;
+    }
+
+    if (best < 0) {
+        return false;
+    }
+
+    out->ra_axis_deg  = c[best].ra;
+    out->dec_axis_deg = c[best].dec;
+    out->pier_side    = c[best].pier;
+
+    return true;
+}
+
+/* --------------------------------------------------------------------------
+ * Axis -> Equatorial  (reverse conversion)
+ *
+ * The pier side is reliably encoded in the sign of dec_axis because
+ * DEC is linear (not normalised):
+ *
+ *   dec_axis >= 0  ->  pierEast  ->  HA = ra + offset,  DEC = dec - 90
+ *   dec_axis <  0  ->  pierWest  ->  HA = ra - offset,  DEC = -dec - 90
+ * -------------------------------------------------------------------------- */
+EquatorialCoordinates geometry_axis_to_equatorial(const GeometryContext *ctx,
+                                                  AxisCoordinates axis) {
+    EquatorialCoordinates out;
+
+    /* DEC is computed directly for every position.  At dec_axis == 0 (the
+     * exact pole) DEC is -90 and RA is degenerate: the formula still returns
+     * a valid, if arbitrary, RA — no threshold erases the nearby cone. */
+    float ha_deg, dec_deg;
+    if (axis.dec_axis_deg >= 0.0f) {
+        /* pierEast: stored = -(offset - HA) = HA - offset  ->  HA = ra + offset */
+        ha_deg  = normalize_degf(axis.ra_axis_deg + mount_profile.ra_reference_offset_deg);
+        dec_deg = axis.dec_axis_deg - 90.0f;
+    } else {
+        /* pierWest: stored = -(-offset - HA) = HA + offset  ->  HA = ra - offset */
+        ha_deg  = normalize_degf(axis.ra_axis_deg - mount_profile.ra_reference_offset_deg);
+        dec_deg = -axis.dec_axis_deg - 90.0f;
+    }
+
+    float ha_h = ha_deg / 15.0f;
+
+    double lst = geometry_gmst_hours(ctx->unix_seconds) + (ctx->lon_deg / 15.0);
+
+    out.ra_hours = normalize_hoursf((float)(lst - ha_h));
+
+    if (dec_deg < -90.0f) dec_deg = -90.0f;
+    if (dec_deg >  90.0f) dec_deg =  90.0f;
+    out.dec_deg = dec_deg;
+
+    return out;
+}
+
+/* --------------------------------------------------------------------------
+ * Plan a goto: solve at the request instant, lock the pier side, estimate the
+ * two-axis ramp duration and re-solve at the arrival instant on that side.
+ * -------------------------------------------------------------------------- */
+bool geometry_plan_goto(const GeometryContext *ctx, EquatorialCoordinates eq,
+                        AxisCoordinates current, PierSideRequirement required,
+                        float speed_dps, GotoPlan *plan) {
+    if (!plan) {
+        return false;
+    }
+
+    AxisCoordinates axis_now;
+    if (!geometry_equatorial_to_axis(ctx, eq, current, required, 0.0f, &axis_now)) {
+        return false;
+    }
+    PierSideRequirement locked = (axis_now.pier_side == PIER_SIDE_EAST)
+                                 ? PIER_SIDE_EAST : PIER_SIDE_WEST;
+
+    /* Two-axis slew: the slower axis (larger ramp duration) wins. */
+    float ra_dist = fabsf(axis_now.ra_axis_deg - current.ra_axis_deg);
+    float dec_dist = fabsf(axis_now.dec_axis_deg - current.dec_axis_deg);
+    float duration = fmaxf(slew_ramp_duration(&mount_profile.slew, ra_dist, speed_dps),
+                           slew_ramp_duration(&mount_profile.slew, dec_dist, speed_dps));
+
+    /* Re-solve at the arrival instant on the locked side: same site/limits,
+     * only the instant advances. */
+    GeometryContext arrival = *ctx;
+    arrival.unix_seconds = ctx->unix_seconds + (double) duration;
+    if (!geometry_equatorial_to_axis(&arrival, eq, current, locked, 0.0f,
+                                     &plan->target)) {
+        return false;
+    }
+    plan->pier_side = locked;
+    plan->duration_s = duration;
+    return true;
+}
diff --git a/main/geometry/mount_geometry.h b/main/geometry/mount_geometry.h
new file mode 100644
index 0000000..03c6518
--- /dev/null
+++ b/main/geometry/mount_geometry.h
@@ -0,0 +1,105 @@
+#pragma once
+
+#include <stdbool.h>
+
+/* Sidereal tracking rate (degrees/second). */
+#define GEOMETRY_SIDEREAL_DPS 0.004178074f
+
+/*
+ * Pure mount geometry — coordinate spaces and conversion functions.
+ *
+ * The geometry is a pure layer: every conversion takes an explicit context
+ * (site, instant, mechanical limits) and never reads global state, the wall
+ * clock, NVS, GPIO or motor state.  The same inputs always produce the same
+ * output.  The mount layer (mount_coordinate_tools.c) adapts these pure
+ * functions to the current mutable state.
+ *
+ * Coordinate spaces:
+ *   Equatorial (sky):   RA in decimal hours [0,24), DEC in degrees [-90,90].
+ *   Axis (mechanical):  RA/DEC axis angles in degrees from HOME.  DEC is linear
+ *                       and is NOT normalised as a circle.
+ */
+
+/* Equatorial (sky) coordinates. */
+typedef struct {
+    float ra_hours;
+    float dec_deg;
+} EquatorialCoordinates;
+
+/* Mechanical axis coordinates.  `pier_side` is filled by the forward conversion. */
+typedef struct {
+    float ra_axis_deg;
+    float dec_axis_deg;
+    int pier_side;      /* 0 = pierEast, 1 = pierWest */
+} AxisCoordinates;
+
+/* Destination pier side requested for a goto (German equatorial policy). */
+typedef enum {
+    PIER_SIDE_AUTO = -1,
+    PIER_SIDE_EAST = 0,
+    PIER_SIDE_WEST = 1,
+} PierSideRequirement;
+
+/* Mechanical limits snapshot (immutable for a single conversion). */
+typedef struct {
+    float ra_min;
+    float ra_max;
+    float dec_min;
+    float dec_max;
+} GeometryLimits;
+
+/* Immutable geometry context: site, fractional instant and limits snapshot. */
+typedef struct {
+    float lat_deg;       /* unused by the German model; the fork (PR3) uses it */
+    float lon_deg;
+    double unix_seconds; /* fractional unix instant */
+    GeometryLimits limits;
+} GeometryContext;
+
+/* GMST in hours [0,24) for a fractional unix instant (USNO formula). */
+double geometry_gmst_hours(double unix_seconds);
+
+/* Local sidereal time in hours [0,24) for a longitude at a fractional instant. */
+float geometry_lst(float lon_deg, double unix_seconds);
+
+/* sin(geometric altitude) of a mechanical position at a site latitude
+ * (fork geometry).  Pure. */
+double geometry_altitude_sin(float ra_axis_deg, float dec_axis_deg, float lat);
+
+/* True when every mechanical position in the axis-aligned rectangle from
+ * (ra_from, dec_from) to (ra_to, dec_to) is at or above the geometric horizon
+ * (fork geometry).  Pure. */
+bool geometry_path_above_horizon(float ra_from, float dec_from,
+                                 float ra_to, float dec_to, float lat);
+
+/* Reverse conversion — axis (mechanical) to equatorial (sky).  Pure. */
+EquatorialCoordinates geometry_axis_to_equatorial(const GeometryContext *ctx,
+                                                  AxisCoordinates axis);
+
+/* Forward conversion — equatorial to axis, selecting the mechanical solution.
+ * Pure.  `speed_dps` drives the arrival compensation: the German geometry
+ * ignores it (the mount layer re-solves at the arrival instant); the fork
+ * geometry advances each candidate by the sidereal rate over its travel time.
+ * `required` is the German pier-side policy; the fork rejects non-AUTO. */
+bool geometry_equatorial_to_axis(const GeometryContext *ctx,
+                                 EquatorialCoordinates eq,
+                                 AxisCoordinates current,
+                                 PierSideRequirement required,
+                                 float speed_dps,
+                                 AxisCoordinates *out);
+
+/* A planned goto: the final axis target, the selected pier side and the
+ * estimated single-slew duration. */
+typedef struct {
+    AxisCoordinates target;
+    int pier_side;      /* PIER_SIDE_EAST/WEST (german) or -1 (fork) */
+    float duration_s;
+} GotoPlan;
+
+/* Plan a goto: select the mechanical solution and apply the arrival
+ * compensation, returning the final axis target for the sky target.  The
+ * geometry owns the strategy (German: lock side, re-solve at arrival; fork:
+ * minimum travel with per-candidate advance) from a single context.  Pure. */
+bool geometry_plan_goto(const GeometryContext *ctx, EquatorialCoordinates eq,
+                        AxisCoordinates current, PierSideRequirement required,
+                        float speed_dps, GotoPlan *plan);
diff --git a/main/motion/axis_units.c b/main/motion/axis_units.c
new file mode 100644
index 0000000..c236b0b
--- /dev/null
+++ b/main/motion/axis_units.c
@@ -0,0 +1,19 @@
+/* Motion — axis_units.c — mechanical unit conversion (per axis). */
+#include "axis_units.h"
+
+#include "mount_profile.h"
+
+double axis_deg_per_step(AxisId axis) {
+    const AxisProfile *a = &mount_profile.axes[axis];
+    return (double) a->full_step_deg
+           / ((double) a->canonical_microsteps * (double) a->gear_ratio);
+}
+
+int64_t axis_deg_to_steps(AxisId axis, double degrees) {
+    double step = axis_deg_per_step(axis);
+    return (int64_t)(degrees / step + (degrees >= 0.0 ? 0.5 : -0.5));
+}
+
+double axis_steps_to_deg(AxisId axis, int64_t steps) {
+    return (double) steps * axis_deg_per_step(axis);
+}
