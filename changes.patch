+#pragma once
+
+#include <stdint.h>
+
+#include "mount_profile.h"   /* AxisId */
+
+/*
+ * Mechanical unit conversion — degrees <-> canonical microsteps, per axis.
+ *
+ * The single implementation of the scale and the round-to-nearest conversion,
+ * shared by geometry (double) and motors (float wrappers), so both layers agree
+ * on quantization near the mechanical limits.
+ */
+
+/* Degrees per canonical microstep for one axis. */
+double axis_deg_per_step(AxisId axis);
+
+/* Nearest canonical microstep count for a signed angle in degrees. */
+int64_t axis_deg_to_steps(AxisId axis, double degrees);
+
+/* Angle in degrees for a canonical microstep count. */
+double axis_steps_to_deg(AxisId axis, int64_t steps);
diff --git a/main/motion/slew_ramp.c b/main/motion/slew_ramp.c
new file mode 100644
index 0000000..cc3706f
--- /dev/null
+++ b/main/motion/slew_ramp.c
@@ -0,0 +1,110 @@
+/* Motion — slew_ramp.c — shared slew velocity profile and duration estimate. */
+#include "slew_ramp.h"
+
+#include <math.h>
+
+/*
+ * Velocity percentage (0-100) at a given travelled distance for the
+ * distance-based trapezoidal profile: the first accel window is linear
+ * acceleration, the last decel window is linear deceleration, and the middle is
+ * cruise.  A move shorter than the full accel+decel window uses a triangular
+ * profile whose peak sits proportionally to the accel/decel windows.
+ */
+static float ramp_percent(const SlewProfile *p, float distance_deg, float travelled_deg) {
+    float accel = p->accel_distance_deg;
+    float decel = p->decel_distance_deg;
+    float total = accel + decel;
+
+    if (distance_deg <= total) {
+        if (total <= 0.0f) return 100.0f;
+        float peak = distance_deg * accel / total;
+        if (peak <= 0.0f) return 100.0f;
+        if (travelled_deg < peak)
+            return travelled_deg * 100.0f / peak;
+        float decel_len = distance_deg - peak;
+        if (decel_len <= 0.0f) return 100.0f;
+        return (distance_deg - travelled_deg) * 100.0f / decel_len;
+    }
+
+    if (accel > 0.0f && travelled_deg < accel)
+        return travelled_deg * 100.0f / accel;
+    if (decel > 0.0f && travelled_deg < distance_deg - decel)
+        return 100.0f;
+    if (decel > 0.0f)
+        return (distance_deg - travelled_deg) * 100.0f / decel;
+    return 100.0f;
+}
+
+float slew_ramp_velocity(const SlewProfile *p, float distance_deg,
+                         float travelled_deg, float target_speed_dps) {
+    if (!isfinite(distance_deg) || !isfinite(travelled_deg) || !isfinite(target_speed_dps)) {
+        return 0.0f;
+    }
+    if (target_speed_dps <= 0.0f) {
+        return 0.0f;
+    }
+    if (distance_deg <= 0.0f) {
+        return target_speed_dps;
+    }
+
+    if (distance_deg < p->short_distance_deg) {
+        return p->min_speed_dps;
+    }
+
+    float capped = target_speed_dps;
+    if (distance_deg < p->gentle_distance_deg) {
+        if (capped > p->gentle_max_dps) capped = p->gentle_max_dps;
+    }
+
+    float pct = ramp_percent(p, distance_deg, travelled_deg);
+    return p->min_speed_dps + (capped - p->min_speed_dps) * pct / 100.0f;
+}
+
+float slew_ramp_duration(const SlewProfile *p, float distance_deg, float target_speed_dps) {
+    if (!isfinite(distance_deg) || !isfinite(target_speed_dps)) {
+        return 0.0f;
+    }
+    if (distance_deg <= 0.0f || target_speed_dps <= 0.0f) {
+        return 0.0f;
+    }
+
+    float min = p->min_speed_dps;
+    if (min <= 0.0f) {
+        return 0.0f;
+    }
+
+    float capped = target_speed_dps;
+    if (distance_deg < p->short_distance_deg) {
+        capped = min;
+    } else if (distance_deg < p->gentle_distance_deg) {
+        if (capped > p->gentle_max_dps) capped = p->gentle_max_dps;
+    }
+
+    if (distance_deg < p->short_distance_deg) {
+        return distance_deg / min;
+    }
+
+    /* Guard the v == vmin singular case: the analytic limit is 1/vmin. */
+    float delta = capped - min;
+    float ramp_ln;
+    if (fabsf(delta) < 1e-6f) {
+        ramp_ln = 1.0f / min;
+    } else {
+        ramp_ln = log1pf(delta / min) / delta;
+    }
+
+    float accel = p->accel_distance_deg;
+    float decel = p->decel_distance_deg;
+
+    if (distance_deg <= accel + decel) {
+        /* Triangular profile (symmetric in every current profile). */
+        return distance_deg * ramp_ln;
+    }
+
+    /* Trapezoidal: accel + cruise + decel, with the two ramp legs summed
+     * separately so asymmetric windows are handled correctly. */
+    float t_accel = accel * ramp_ln;
+    float t_decel = decel * ramp_ln;
+    float result = t_accel + t_decel + (distance_deg - accel - decel) / capped;
+    return isfinite(result) ? result : 0.0f;
+}
diff --git a/main/motion/slew_ramp.h b/main/motion/slew_ramp.h
new file mode 100644
index 0000000..e193d75
--- /dev/null
+++ b/main/motion/slew_ramp.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include "mount_profile.h"   /* SlewProfile */
+
+/*
+ * Slew ramp — the single implementation of the distance-based trapezoidal
+ * velocity profile and its closed-form duration integral.
+ *
+ * Both the motion executor (velocity per batch) and the arrival-time estimator
+ * (duration) consume these pure functions, so the predicted goto duration
+ * matches the real velocity profile.
+ */
+
+/* Effective velocity (deg/s) at `travelled_deg` into a single-axis move of
+ * `distance_deg`, targeting `target_speed_dps`.  Returns 0 for non-finite
+ * inputs or a non-positive target speed. */
+float slew_ramp_velocity(const SlewProfile *p, float distance_deg,
+                         float travelled_deg, float target_speed_dps);
+
+/* Estimated duration (seconds) of a single-axis move of `distance_deg` at
+ * `target_speed_dps`.  Returns 0 for non-finite inputs, a non-positive distance
+ * or speed, or a non-finite result. */
+float slew_ramp_duration(const SlewProfile *p, float distance_deg,
+                         float target_speed_dps);
diff --git a/main/motors/motors.h b/main/motors/motors.h
index 0dd04db..1f9c4d1 100644
--- a/main/motors/motors.h
+++ b/main/motors/motors.h
@@ -4,6 +4,8 @@
 #include <stdint.h>
 #include "esp_err.h"
 
+#include "mount_profile.h"
