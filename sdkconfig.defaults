# sdkconfig.defaults — project-specific overrides for Montura
# Applied automatically by idf.py build on top of ESP-IDF defaults.

# Flash: ESP32-S3 N8R8 has 8 MB
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# CPU: 240 MHz — headroom for REST/Alpaca response and batch computation
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Partition table: large single-app (3 MB factory partition)
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_PARTITION_TABLE_FILENAME="partitions_singleapp_large.csv"

# TinyUSB: NCM network mode
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_NCM_OUT_NTB_BUFF_MAX_SIZE=5120
CONFIG_TINYUSB_NCM_IN_NTB_BUFF_MAX_SIZE=5120

# TinyUSB: custom USB descriptors
# (disable the default VID/PID so the custom values below take effect)
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=n
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_CUSTOM_VID=0x303A
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x4001
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="NRM-WO"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Mount USB Ethernet"
CONFIG_TINYUSB_DESC_SERIAL_STRING="000001"

# LWIP: more sockets for multiple HTTP servers + Alpaca
CONFIG_LWIP_MAX_SOCKETS=32

# LWIP: more active TCP connections — rapid REST/Alpaca polling exhausts the
# default 16-PCB pool (FIN_WAIT_2/TIME_WAIT), which makes accept() fail and
# freezes the network.
CONFIG_LWIP_MAX_ACTIVE_TCP=48

# SNTP: network time sync over the USB link (host NTP + public pools).
# The lwIP SNTP app is always compiled in this IDF; only the server
# count needs to match ESP_NETIF_SNTP_DEFAULT_CONFIG_MULTIPLE's list.
CONFIG_LWIP_SNTP_MAX_SERVERS=4

# Compiler: performance optimization (-O2) instead of debug (-Og)
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ── FreeRTOS: 1000 Hz tick for fine-grained RMT batch polling ──
# The decoupled slew loop polls RMT completion at 1 ms granularity.  A
# 100 Hz tick makes vTaskDelay(1ms) resolve to 0 ticks (a no-op) and the
# motion task busy-spins, starving IDLE and tripping the task watchdog.
CONFIG_FREERTOS_HZ=1000

# ── Task watchdog: don't monitor the CPU0 idle task ──
# Under sustained network load (N.I.N.A. polling status while MoveAxis holds
# the axis) every network task — tcpip, TinyUSB, both httpd servers and
# usb_net_tx — runs on CPU 0, so the idle task legitimately starves for >5 s.
# That is high load making progress, not a hang, and monitoring the idle task
# turns it into a spurious "Task watchdog got triggered" warning/reset.
# CPU 1 (the motors_motion task, prio 23) stays protected via IDLE1.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n

# ── CPU affinity: all non-motion tasks pinned to CPU 0 ──
# CPU 1 is reserved exclusively for the motors_motion task (prio 23).
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y
CONFIG_ESP_TIMER_ISR_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# ── RMT: ISR in IRAM for minimum latency ──
CONFIG_RMT_ISR_IRAM_SAFE=y
